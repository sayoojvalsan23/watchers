[Unit]
Description=Himalayan Early Warning - rainfall watch (Phase 5b, Kerala)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hew
WorkingDirectory=/opt/hew
# 3-hourly cycle. Rainfall accumulates over 12-72 h, so this loses nothing --
# unlike the seismic watcher, where latency is the entire product.
#
# QUOTA: Open-Meteo is free but capped (~10,000 locations/day) and prices by
# LOCATION, not by HTTP call. 316 model-grid nodes x 8 cycles = 2,528/day,
# which fits. Raising the cadence or dropping --limit without redoing that
# arithmetic will silently kill the service every afternoon.
ExecStart=/usr/bin/python3 -m hew.rain_watcher \
    --db /var/lib/hew/hew.db \
    --interval 10800
Restart=always
RestartSec=60
# Dispatch is OFF. This raises a WATCH at ~12 alerts/year against a gate of 2:
# a defensible attention product, NOT an evacuation trigger. Turning it on is
# an institutional decision, not a deployment one.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
